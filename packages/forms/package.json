{
  "name": "@fabric-kit/forms",
  "version": "0.0.0",
  "description": "Typed React Hook Form bindings for Fabric inputs, with Zod validation.",
  "license": "MIT",
  "author": "Ahmed Bilal",
  "homepage": "https://ahmedbilal5.github.io/fabric/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedBilal5/fabric.git",
    "directory": "packages/forms"
  },
  "bugs": {
    "url": "https://github.com/ahmedBilal5/fabric/issues"
  },
  "keywords": [
    "fabric",
    "react",
    "forms",
    "react-hook-form",
    "zod"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@fabric-kit/components": "workspace:*",
    "@fabric-kit/date-picker": "workspace:*",
    "@fabric-kit/design-tokens": "workspace:*",
    "@fabric-kit/icons": "workspace:*",
    "@hookform/resolvers": "^5.2.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-hook-form": "^7.92.0",
    "zod": "^3.25.0 || ^4.0.0",
    "@mui/material": "^9.0.0",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-hook-form": "^7.92.0",
    "zod": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
