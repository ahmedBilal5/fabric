{
  "name": "@fabric-kit/hooks",
  "version": "0.0.0",
  "description": "React hooks and formatting helpers for Fabric apps: disclosure, debounce, hotkeys, clipboard, local storage, and locale-aware dates, numbers and file sizes.",
  "license": "MIT",
  "author": "Ahmed Bilal",
  "homepage": "https://ahmedbilal5.github.io/fabric/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedBilal5/fabric.git",
    "directory": "packages/hooks"
  },
  "bugs": {
    "url": "https://github.com/ahmedBilal5/fabric/issues"
  },
  "keywords": [
    "fabric",
    "react",
    "hooks",
    "intl",
    "formatting",
    "design-system"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
