{
  "name": "fabric",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "typecheck:stories": "turbo build --filter=@fabric-kit/icons && tsc -p tsconfig.stories.json",
    "test": "turbo test",
    "playwright:install": "playwright install chromium",
    "test-storybook": "pnpm run playwright:install && vitest --project=storybook",
    "test-storybook:watch": "pnpm run playwright:install && vitest --project=storybook --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:fix-unsafe": "biome check --write --unsafe .",
    "storybook": "storybook dev -p 6007",
    "storybook:build": "storybook build",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "site:dev": "pnpm --filter @fabric-kit/site dev",
    "site:build": "turbo build --filter=@fabric-kit/site",
    "pages:build": "pnpm site:build && pnpm storybook:build && node scripts/assemble-pages.mjs",
    "check:icons": "node scripts/check-icon-imports.mjs",
    "audit:themes": "node scripts/theme-audit.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^2.27.0",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^9.0.0",
    "@mui/lab": "^9.0.0-beta.0",
    "@mui/material": "^9.0.0",
    "@mui/x-data-grid": "^9.0.0",
    "@mui/x-date-pickers": "^9.0.0",
    "@mui/x-tree-view": "^9.0.0",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-themes": "^10.5.0",
    "@storybook/addon-vitest": "10.5.6",
    "@storybook/react-vite": "^10.5.0",
    "@types/node": "^22",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/browser": "^3.2.0",
    "axe-core": "^4.14.0",
    "dayjs": "^1.11.10",
    "playwright": "^1.55.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.55.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.5.0",
    "storybook-dark-mode": "^5.0.0",
    "tsup": "^8.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  },
  "description": "Fabric: a free, open-source design system and component kit built on MUI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedBilal5/fabric.git"
  },
  "homepage": "https://ahmedbilal5.github.io/fabric/"
}
